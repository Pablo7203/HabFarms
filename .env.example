NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://www.habfarm.com
# The token Google Search Console provides for the HTML-tag verification method.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
PLATFORM_EMAIL_FROM=
